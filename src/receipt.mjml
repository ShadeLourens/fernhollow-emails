<!-- Email 2: the receipt a donor gets after giving. A transactional email,
     so it's only about the gift: no unsubscribe link and no marketing links. -->
<mjml lang="en">
  <mj-head>
    <!-- "Receipt" is in the subject, because donors search for it at tax time -->
    <mj-title>Your receipt from Fernhollow Animal Alliance</mj-title>
    <!-- Hidden preheader: Engaging Networks fills {preview_text} from its Preview Text field -->
    <mj-preview>{preview_text}</mj-preview>
    <mj-include path="./layout/head.mjml" />
  </mj-head>

  <mj-body background-color="#001f3d" width="600px">
    <mj-include path="./layout/header.mjml" />

    <!-- The letter. Editors can drag new blocks into this area in Engaging Networks,
         and each group inside it can be duplicated (repeatable). -->
    <mj-raw><div class="en__component en__component--droppable ui-sortable"></mj-raw>

    <!-- Thank you -->
    <mj-raw><div class="en__component en__component--repeatable"></mj-raw>
    <mj-section padding="40px 0 8px">
      <mj-column>
        <mj-text>Hi {user_data~First Name~Friend},</mj-text>
        <mj-text>Thank you for your gift. Because of you, more dogs like Biscuit can get the vet checks, the vaccinations and a quiet place to recover.</mj-text>
        <mj-text>Biscuit's foster family sent us this photo last week. He has claimed the sofa.</mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>

    <!-- Biscuit on the sofa: shown at 520 × 260, the file is twice that size for sharp screens -->
    <mj-raw><div class="en__component en__component--repeatable"></mj-raw>
    <mj-section padding="8px 0 28px">
      <mj-column>
        <mj-text css-class="en__component en__component--imageblock" mj-class="image" padding="0 40px">
          <img src="https://shadelourens.github.io/fernhollow-emails/assets/biscuit-sofa.jpg" width="520" height="260" alt="Biscuit, asleep and curled up on a soft blanket on a sofa." style="display:block; width:100%; max-width:520px; height:auto; border:0; border-radius:12px;">
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>

    <!-- The receipt details: the same cream box with an orange stripe as the appeal's impact box -->
    <mj-raw><div class="en__component en__component--repeatable"></mj-raw>
    <mj-wrapper css-class="impact-wrap" padding="4px 40px 0" background-color="#ffffff">
      <mj-section background-color="#fdf1e4" border-top="4px solid #e87a00" border-radius="0 0 12px 12px" padding="26px 0 26px">
        <mj-column>
          <mj-text mj-class="heading" font-size="21px" line-height="29px" padding="0 28px 12px"><h2 style="margin:0; font-family:'Nunito Sans', Arial, sans-serif; font-size:21px; line-height:29px; font-weight:700; color:#001f3d;">Your receipt</h2></mj-text>
          <mj-text padding="0 28px">
            Amount: <strong>{receipt_data~amount~[en]}</strong><br>
            Date: <strong>{receipt_data~createdOn~[yyyy-MM-dd]}</strong><br>
            Reference: <strong>{receipt_data~txId}</strong><br>
            Receipt sent to: <strong>{user_data~Email}</strong>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-raw></div></mj-raw>

    <!-- Tax note and monthly gifts -->
    <mj-raw><div class="en__component en__component--repeatable"></mj-raw>
    <mj-section padding="32px 0 8px">
      <mj-column>
        <mj-text>Please keep this email for your records. Fernhollow Animal Alliance is a 501(c)(3) nonprofit organization, EIN 00-0000000 (fictional). No goods or services were provided in exchange for your gift.</mj-text>
        <mj-text><strong>Giving monthly?</strong> Thank you for being there all year round. Each January, we'll send you one receipt for all your monthly gifts from the year before. You can change or cancel your monthly gift any time by replying to this email or writing to <a href="mailto:donors@fernhollow.example">donors@fernhollow.example</a>.</mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>

    <!-- Sign-off -->
    <mj-raw><div class="en__component en__component--repeatable"></mj-raw>
    <mj-section padding="8px 0 20px">
      <mj-column>
        <mj-text>With gratitude,</mj-text>
        <mj-text line-height="24px"><strong style="font-family:'Nunito Sans', Arial, sans-serif; font-size:18px;">Maya Daniels</strong><br><span style="font-size:16px; color:#045174;">Rescue Coordinator, Fernhollow Animal Alliance</span></mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>

    <!-- End of the droppable area -->
    <mj-raw></div></mj-raw>

    <!-- Footer: teal like the header, and locked in Engaging Networks.
         No unsubscribe link, because a receipt isn't marketing. -->
    <mj-section background-color="#045174" padding="32px 0 36px">
      <mj-column>
        <mj-text mj-class="footer">You're receiving this because you made a gift to Fernhollow Animal Alliance.</mj-text>
        <mj-include path="./layout/footer.mjml" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
