<!-- Header: the logo on teal. The image carries its own teal background, so
     nothing changes color in dark mode. It has no en__component class, so it's
     locked in Engaging Networks. The alt text is styled to look like a heading
     when images are turned off. The logo is the email's main heading (h1),
     so screen readers announce "Fernhollow Animal Alliance, heading level 1". -->
<mj-section background-color="#045174">
  <mj-column>
    <mj-text css-class="header" mj-class="image" padding="0">
      <h1 style="margin:0;"><img src="https://shadelourens.github.io/fernhollow-emails/assets/header.png" width="600" height="89" alt="Fernhollow Animal Alliance" style="display:block; width:100%; max-width:600px; height:auto; border:0; font-family:'Nunito Sans', Arial, sans-serif; font-size:26px; font-weight:700; color:#f8dcbf;"></h1>
    </mj-text>
  </mj-column>
</mj-section>
